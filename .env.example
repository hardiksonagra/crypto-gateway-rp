# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Production (PM2): serve React build from the same Node process when `client/dist` exists, or set explicitly:
# CLIENT_DIST_PATH=/absolute/path/to/client/dist
# Split API vs blockchain worker (see ecosystem.config.cjs). API process:
# RUN_BLOCKCHAIN_WORKER=false
# Then run worker: `pm2 start ecosystem.config.cjs` (includes crypto-gateway-worker) or `node server/src/worker-entry.js`

# Optional: allow simulate-deposit with the *live* API key (never enable in production).
# Merchants should use their sandbox API key from the portal instead.
# GATEWAY_SANDBOX=true

# Portal JWT signing (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

# Comma-separated browser origins (the SPA’s URL — usually Vite :5173 — not only the API :3000).
# If the portal and API are on different hosts, list the **portal** origin(s) here (what the browser shows in the address bar), e.g.:
# CLIENT_ORIGINS=https://portal.cryptovapay.com,https://portal.cryptovapay.com
# Build the React app with VITE_API_ORIGIN pointing at the API host (e.g. https://api.cryptovapay.com).
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# React client: API base URL (browser calls this host). Dev default in code is http://localhost:3000 if unset.
# VITE_API_ORIGIN=http://localhost:3000
# Production split hosts: VITE_API_ORIGIN=https://api.cryptovapay.com
# Optional: if you host a separate sandbox API, merchant Doc page can use this for simulate-deposit copy URLs.
# VITE_GATEWAY_DOCS_SANDBOX_ORIGIN=https://sandbox-api.example.com

# Password reset links in email point here (SPA origin, no trailing slash).
APP_PUBLIC_URL=http://localhost:5173
# PASSWORD_RESET_TTL_MINUTES=60

# Optional SMTP — required to actually send forgot-password emails (omit in dev to log reset URL in server logs).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Paython <noreply@example.com>"

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_wallet?schema=public"
# If Prisma says P1013 "invalid port number", your user or password likely contains @ : # / ? % & +
# — those break the URL. Percent-encode them in USER and PASSWORD (e.g. @ → %40, : → %3A, # → %23).
# Example: password "p@ss#1" → postgresql://myuser:p%40ss%231@127.0.0.1:5432/mydb?schema=public
# Node one-liner: node -e "console.log(encodeURIComponent('your-raw-password'))"

# HD root secret — NEVER commit real values. Use KMS/HSM in production.
MNEMONIC="test test test test test test test test test test test junk"

# Optional: 64 hex chars (32 bytes) AES-256 key. If unset, merchant API key ciphertext uses a key derived from JWT_SECRET.
# Used to encrypt `admin_users.api_key_cipher` (full gateway key for merchant Doc page).
ENCRYPTION_KEY=

# Confirmation thresholds (inclusive)
CONFIRMATIONS_EVM=12
CONFIRMATIONS_TRON=20
CONFIRMATIONS_BTC=3

# Worker interval (ms)
WORKER_POLL_INTERVAL_MS=8000
# Max outbound RPC / explorer HTTP calls per rolling second **per network** (EVM_ETH, TRON, BTC, TON).
# Worker + withdrawals wait (queue) instead of failing. Set to 0 to disable.
# OUTBOUND_RPC_MAX_PER_SECOND=5
# Live deposit scan window for new wallets (minutes). `0` = no expiry (always scan). Late pay: reactivate via portal/API.
# WALLET_SCAN_TTL_MINUTES=10
# Re-check expired zero-tx wallets every N hours (TRON/TON/BTC address APIs only). `0` = off. EVM needs reactivate for old blocks.
# LATE_DEPOSIT_RECHECK_HOURS=6
# Log counts of **new** transaction rows inserted per scan tick, by rail (USDT|TRC20, …).
# always (default) = every tick (zeros too — confirms worker ran); nonzero = only when inserts > 0; off = no extra DB read
# WORKER_LOG_RAIL_COUNTS=nonzero

# EVM JSON-RPC — standard HTTPS URLs (ethers JsonRpcProvider). No extra QuickNode SDK in this repo:
# create one Core API endpoint per chain in the QuickNode dashboard and paste each URL here, or use
# Alchemy / Infura / your own node the same way. Keys are usually embedded in the URL path.
# Public RPCs throttle or 502 under load — paid endpoints avoid that for deposit scanning + withdraws.
# https://www.quicknode.com
RPC_ETH=https://smart-special-liquid.quiknode.pro/089d67194a33cc62b78aa81bc6fcf27ee4b2d182/
RPC_BNB=https://bsc-dataseed.binance.org
RPC_POLYGON=https://polygon-bor-rpc.publicnode.com
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_OPTIMISM=https://mainnet.optimism.io

# TON — TonAPI-compatible HTTPS base (jetton + native TON deposits). For higher limits set TON_API_KEY;
# only change TON_API_BASE if you use another TonAPI-compatible host.
TON_API_BASE=https://tonapi.io
TON_API_KEY=
CONFIRMATIONS_TON=2

# TRON — HTTP JSON API base (same host for full/solidity/event in typical setups). For QuickNode or
# TronGrid, point all three at your provider URL; set TRON_API_KEY if the provider expects
# TRON-PRO-API-KEY (see their docs).
TRON_FULL_NODE=https://api.trongrid.io
TRON_SOLIDITY_NODE=https://api.trongrid.io
TRON_EVENT_SERVER=https://api.trongrid.io
TRON_API_KEY=

# Bitcoin — this gateway calls an Esplora-style REST base (paths like /address/.../txs), not Bitcoin
# Core JSON-RPC. Mempool.space works; a generic “Bitcoin RPC” URL from a provider may not unless it
# exposes the same HTTP shape.
BTC_EXPLORER_API_BASE=https://mempool.space/api

# Tracked ERC20/BEP20/TRC20 — JSON maps chain -> contract -> { symbol, decimals }
# Example (minify to one line in .env):
# ERC20_CONTRACTS={"ETH":{"0x...":{"symbol":"USDT","decimals":6}}}
# TRC20: mainnet USDT is merged by default; add other TRC-20 contracts here (merged with defaults).
# TRC20_CONTRACTS={"Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx":{"symbol":"USDC","decimals":6}}
# TON jettons (TEP-74): mainnet USDT merged by default; add others as { "friendly_or_0:hex": { "symbol", "decimals" } }
# TON_JETTON_CONTRACTS={}

ERC20_CONTRACTS={}
TRC20_CONTRACTS={}

# Sweep (optional) — master receive addresses; leave empty to disable
SWEEP_MASTER_EVM=
SWEEP_MASTER_TRON=
SWEEP_MASTER_BTC=
