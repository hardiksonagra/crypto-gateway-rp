# =============================================================================
# Multi-service layout (see docs/split-services.md)
# -----------------------------------------------------------------------------
# 1) React (client)  — build with VITE_API_ORIGIN pointing at your API public URL.
# 2) API (server)    — HTTP + optional static client/dist; needs DATABASE_URL, CORS, JWT, RPC, MNEMONIC, …
# 3) Cron (cron/)    — worker + PM2 cron-*; same DATABASE_URL + chain env as API; no HTTP link to API required.
# =============================================================================
#
# Copy to `.env` at repo root and/or `server/.env` (server scripts load both).
# Cron also reads repo root `.env` then `cron/.env` (see cron/src/bootstrap-runtime.js).
#
# Most tunables (RPC URLs, TRON, ERC20/Etherscan, confirmations, worker, sweep, gateway flags) live in Admin → System settings
# after first boot. Restart PM2 `crypto-gateway-worker-erc20`, `crypto-gateway-worker-trc20`, `crypto-gateway-cron-maintenance`, `crypto-gateway-cron-deposit-full-scan`, `crypto-gateway-cron-tron-sweep` when you change scanner poll ms or other cron-only settings.
#
# Prisma schema lives in server/prisma/. From repo root run: npm run migrate:deploy  (or npm run prisma:deploy).
# Do not run bare `npx prisma migrate deploy` in the monorepo root — it will not find the schema.
#
# Keep in env only (not in Admin DB UI): DATABASE_URL, MNEMONIC, JWT_SECRET, ENCRYPTION_KEY (optional),
# SWEEP_TRX_FUNDER_PRIVATE_KEY (optional).
# Tunables like TRONSCAN_API_KEY / ETHERSCAN_API_KEY / RPC_* / TRON_* can be set in Admin → System settings (DB); non-empty DB values override .env.
# Per-chain on/off is edited in Admin → Supported chains (stored as JSON `CHAIN_ENABLED` in `app_settings`); optional bootstrap: CHAIN_ENABLED={"ETH":false,...}

# --- Shared: API + every cron process must use the same PostgreSQL ---
NODE_ENV=development
PORT=3000

JWT_SECRET=change-me-to-a-long-random-secret
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_wallet?schema=public"
# URL-encode special chars in DB user/password (@ : # …) — see Prisma docs if connection fails.

MNEMONIC="test test test test test test test test test test test junk"

# --- API ↔ React (when React is on another host, list its origin here) ---
# Browser CORS: comma-separated origins. Also auto-allows APP_PUBLIC_URL and PAYMENT_PAGE_PUBLIC_URL origins.
# NODE_ENV=development always merges localhost/127.0.0.1 on ports 5173, 3000, 4173.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
APP_PUBLIC_URL=http://localhost:5173
#
# Production — typical split: `portal.example.com` (React) + `api.example.com` (this Node API)
#   | What              | Host example              | Set to |
#   |-------------------|---------------------------|--------|
#   | Users open        | https://portal.example.com | APP_PUBLIC_URL=https://portal.example.com |
#   | CORS allow-list   | same portal origin only   | CLIENT_ORIGINS=https://portal.example.com |
#   | Client build      | API base, no trailing /   | VITE_API_ORIGIN=https://api.example.com |
# Do NOT put https://api… in CLIENT_ORIGINS — the browser’s Origin header is always the portal page, not the API host.
# (CORS also auto-allows APP_PUBLIC_URL’s origin; `www` / non-`www` twin is added for each listed origin.)
# Admin → System settings: if CLIENT_ORIGINS there is non-empty, it overrides .env — include the live portal origin, not localhost.
# — API server .env (concrete):
#     NODE_ENV=production
#     APP_PUBLIC_URL=https://portal.cryptovapay.com
#     CLIENT_ORIGINS=https://portal.cryptovapay.com
# — Client production build:
#     VITE_API_ORIGIN=https://api.cryptovapay.com
#
# If CORS errors persist:
#   1) PM2 logs: `cors_origin_rejected` shows the browser Origin — must match CLIENT_ORIGINS / APP_PUBLIC_URL (https vs http, host, port).
#   2) Admin → System settings: non-empty CLIENT_ORIGINS there overrides .env — set live portal origin(s) or `*` to allow any Origin.
#   3) Same registrable domain for all SPAs: CORS_ALLOWED_ORIGIN_SUFFIX=example.com  (allows https://portal.example.com, https://pay.example.com, …)
#   4) Temporary: CLIENT_ORIGINS=*  or  CORS_ALLOW_ALL=true  (both reflect the request Origin; use only while debugging)

# TRON — deposit worker uses TronScan HTTP API; TronWeb still needs a full node for balance + sweep.
# 1) TRONSCAN_API_KEY — required for deposit scanner (https://tronscan.org → My account → API keys). Header: TRON-PRO-API-KEY.
#    You can omit it here and set “TronScan API key” in Admin → System settings (stored in `app_settings`); DB overrides .env when non-empty.
# 2) TRONSCAN_API_BASE — optional; default https://apilist.tronscanapi.com
# 3) TRON_FULL_NODE — TronWeb (sweep / estimates); e.g. https://api.trongrid.io (no /jsonrpc/ suffix).
#    Admin “Refresh balances” for TRON uses TronScan: TRONSCAN_API_BASE + TRONSCAN_API_KEY (same as deposit tracker).
# 4) TRON_API_KEY — optional; TronGrid key for TronWeb when using api.trongrid.io as full node.
# 5) DEPOSIT_SCANNER_TRON_ONLY — when true, the worker still scans TRON every tick; for EVM it only loads wallets that already exist (lighter). Set false to run the full ETH block walk each tick. Product rails: USDT·TRC20 + USDT·ERC20 only.
# DEPOSIT_SCANNER_TRON_ONLY=false
#
# Deposit worker: separate poll intervals (ms, min 1000 at runtime). Override per rail in Admin → System settings.
# If unset, both fall back to WORKER_POLL_INTERVAL_MS (default 8000).
# WORKER_POLL_INTERVAL_MS_ERC20=8000
# WORKER_POLL_INTERVAL_MS_TRC20=8000
# WORKER_POLL_INTERVAL_MS=8000
#
# ERC20 deposit tick: max blocks per tick (Admin `EVM_DEPOSIT_SCAN_MAX_BLOCKS_PER_TICK` overrides). Legacy: `EVM_SCAN_MAX_BLOCKS_PER_TICK`.
# EVM_DEPOSIT_SCAN_MAX_BLOCKS_PER_TICK=4
#
# When true (default), gateway API lists/accepts USDT·TRC20 only. Set false or 0 to allow USDT·ERC20 too. Admin → System settings (`GATEWAY_TRON_USDT_ONLY`) overrides after `npm run sync-settings-from-env` / DB seed.
# GATEWAY_TRON_USDT_ONLY=true
# TRONSCAN_API_KEY=
# TRONSCAN_API_BASE=https://apilist.tronscanapi.com

# USDT·ERC20 deposits + admin “Refresh balances” for ETH USDT: **Etherscan API only** (`ETHERSCAN_API_KEY` + `ETHERSCAN_API_BASE`).
# No JSON-RPC is required for those paths (same idea as TronScan for TRC20).
# ETHERSCAN_API_KEY=
# ETHERSCAN_API_BASE=https://api.etherscan.io/v2/api
#
# `RPC_ETH` — optional unless you run **USDT·ERC20 consolidate sweep** (broadcast + gas needs an Ethereum JSON-RPC).
# RPC_ETH=

# One-shot: copy env-backed keys into `app_settings` for this DATABASE_URL (then tune in Admin → System settings).
# npm run sync-settings-from-env
#
# Optional bootstrap only
# Wallet pool: maintenance cron clears expired holds every N minutes (default 30; Admin → System settings).
# WALLET_POOL_HOLD_RELEASE_CRON_MINUTES=30
# ENCRYPTION_KEY=
# CLIENT_DIST_PATH=
# SWEEP_TRX_FUNDER_PRIVATE_KEY=
# --- Client build / Vite dev: browser calls this API base (required if API not on localhost:PORT) ---
# VITE_API_ORIGIN=http://localhost:3000
# Production static build example: VITE_API_ORIGIN=https://api.yourdomain.com
