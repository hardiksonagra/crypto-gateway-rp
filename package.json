{
  "name": "crypto-payment-gateway-monorepo",
  "private": true,
  "workspaces": ["server", "client", "cron"],
  "scripts": {
    "postinstall": "npm run prisma:generate -w server",
    "dev": "npm run dev -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:cron": "npm run dev -w cron",
    "dev:cron:worker": "npm run dev:worker -w cron",
    "dev:cron:worker:erc20": "npm run dev:worker:erc20 -w cron",
    "dev:cron:worker:trc20": "npm run dev:worker:trc20 -w cron",
    "dev:cron:maintenance": "npm run dev:cron:maintenance -w cron",
    "dev:cron:tron-sweep": "npm run dev:cron:tron-sweep -w cron",
    "dev:cron:deposit-full-scan": "npm run dev:cron:deposit-full-scan -w cron",
    "dev:all": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:stack": "concurrently \"npm run dev -w server\" \"npm run dev -w client\" \"npm run dev -w cron\"",
    "start:api": "npm run start -w server",
    "preview:client": "npm run preview -w client",
    "start:cron:worker": "npm run start:worker -w cron",
    "start:cron:worker:erc20": "npm run start:worker:erc20 -w cron",
    "start:cron:worker:trc20": "npm run start:worker:trc20 -w cron",
    "start:cron:maintenance": "npm run start:cron:maintenance -w cron",
    "start:cron:tron-sweep": "npm run start:cron:tron-sweep -w cron",
    "start:cron:deposit-full-scan": "npm run start:cron:deposit-full-scan -w cron",
    "build": "npm run build -w server && npm run build -w client && npm run build -w cron",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:resync": "pm2 delete all 2>/dev/null || true; pm2 start ecosystem.config.cjs && pm2 save",
    "pm2:stop": "pm2 delete crypto-gateway-api crypto-gateway-worker crypto-gateway-worker-erc20 crypto-gateway-worker-trc20 crypto-gateway-cron-maintenance crypto-gateway-cron-deposit-full-scan crypto-gateway-cron-tron-sweep crypto-gateway-cron-1 crypto-gateway-cron-2 crypto-gateway-cron 2>/dev/null || true",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:reset": "npm run prisma:reset -w server",
    "prisma:deploy": "npm run prisma:deploy -w server",
    "migrate:deploy": "npm run prisma:deploy -w server",
    "prisma:studio": "npm run prisma:studio -w server",
    "db:seed": "npm run db:seed -w server",
    "sync-settings-from-env": "npm run sync-settings-from-env -w server",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
