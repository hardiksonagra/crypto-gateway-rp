generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Chain {
  ETH
  BNB
  POLYGON
  ARBITRUM
  OPTIMISM
  TRON
  BTC
  TON
  SOLANA
}

enum TxStatus {
  pending
  success
  failed
  underpaid
  /// Checkout opened with optional `amount`; removed when first on-chain row exists for the session.
  created
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
}

/// End-user rows + gateway keys: live = production chain tracking; sandbox = isolated test data.
enum MerchantGatewayEnv {
  live
  sandbox
}

/// Platform operator portal login (full ops). Email partial-unique where `deleted_at` IS NULL (migration).
model Admin {
  id           Int       @id @default(autoincrement())
  email        String
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  /// Global Users / Transactions list scope in admin UI.
  portalEnvironment MerchantGatewayEnv @default(live) @map("portal_environment")
  passwordResetTokenHash  String?   @map("password_reset_token_hash")
  passwordResetExpiresAt  DateTime? @map("password_reset_expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  settlementsCreated MerchantSettlement[] @relation("SettlementCreatedBy")

  @@index([deletedAt])
  @@map("admins")
}

/// Merchant portal + gateway API identity. Email partial-unique where `deleted_at` IS NULL (migration).
model Merchant {
  id           Int       @id @default(autoincrement())
  email        String
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  apiKeyHash   String?   @unique @map("api_key_hash")
  apiKeyHint   String?   @map("api_key_hint")
  apiKeyCipher String?   @map("api_key_cipher")
  sandboxApiKeyHash   String? @unique @map("sandbox_api_key_hash")
  sandboxApiKeyHint   String? @map("sandbox_api_key_hint")
  sandboxApiKeyCipher String? @map("sandbox_api_key_cipher")
  callbackUrl   String?   @map("callback_url")
  defaultChains Chain[] @default([]) @map("default_chains")
  defaultCurrency String @default("USDT") @map("default_currency")
  defaultNetwork  String @default("TRC20") @map("default_network")
  supportedDepositRails String[] @default([]) @map("supported_deposit_rails")
  isActive      Boolean @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  liveGatewayEnabled    Boolean @default(true) @map("live_gateway_enabled")
  sandboxGatewayEnabled Boolean @default(true) @map("sandbox_gateway_enabled")
  portalEnvironment     MerchantGatewayEnv @default(sandbox) @map("portal_environment")
  passwordResetTokenHash   String?   @map("password_reset_token_hash")
  passwordResetExpiresAt    DateTime? @map("password_reset_expires_at")
  /// Merchant discount rate (fee on gross deposit volume), percent 0–100.
  mdrPercent            Decimal   @default(0) @map("mdr_percent") @db.Decimal(7, 4)
  /// Settlement fee (percent of same gross base as MDR for display and settlement forms).
  settlementRatePercent Decimal   @default(0) @map("settlement_rate_percent") @db.Decimal(7, 4)
  /// Minimum gross (atomic integer string) per settlement for this merchant; "0" = no minimum.
  minSettlementAmount   String    @default("0") @map("min_settlement_amount") @db.VarChar(128)
  /// Successful deposits newer than this many whole days cannot be settled; 0 = no hold.
  settlementPeriodDays  Int       @default(0) @map("settlement_period_days")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  endUsers      User[]
  withdrawals   Withdrawal[]
  pooledWallets Wallet[]
  walletAssignmentEvents WalletAssignmentEvent[]
  settlements   MerchantSettlement[]
  auditLogs     AuditLog[]

  @@index([deletedAt])
  @@map("merchants")
}

/// Admin-recorded settlement payout; `net_amount` reduces portal balance like a withdrawal.
model MerchantSettlement {
  id                    Int                @id @default(autoincrement())
  merchantId            Int                @map("merchant_id")
  merchant              Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  environment           MerchantGatewayEnv @map("environment")
  chain                 Chain
  tokenSymbol           String             @map("token_symbol")
  tokenDecimals         Int                @map("token_decimals")
  grossAmount           String             @map("gross_amount") @db.VarChar(128)
  mdrPercent            Decimal            @map("mdr_percent") @db.Decimal(7, 4)
  settlementRatePercent Decimal            @map("settlement_rate_percent") @db.Decimal(7, 4)
  mdrAmount             String             @map("mdr_amount") @db.VarChar(128)
  settlementFeeAmount   String             @map("settlement_fee_amount") @db.VarChar(128)
  netAmount             String             @map("net_amount") @db.VarChar(128)
  proofFileName         String?            @map("proof_file_name") @db.VarChar(512)
  createdByAdminId      Int?               @map("created_by_admin_id")
  createdByAdmin        Admin?             @relation("SettlementCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  transactionCount      Int                @default(0) @map("transaction_count")
  createdAt             DateTime           @default(now()) @map("created_at")
  deletedAt             DateTime?          @map("deleted_at")

  settledTransactions Transaction[]

  @@index([merchantId, environment, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("merchant_settlements")
}

model User {
  id             Int       @id @default(autoincrement())
  merchantId     Int       @map("merchant_id")
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  externalUserId String    @map("external_user_id")
  environment    MerchantGatewayEnv @default(live) @map("environment")
  accountIndex   Int       @unique @default(autoincrement()) @map("account_index")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  assignedWallets Wallet[] @relation("WalletPoolAssignment")
  payerTransactions Transaction[]
  assignmentEvents WalletAssignmentEvent[]

  @@index([merchantId, externalUserId, environment])
  @@index([merchantId, environment])
  @@index([deletedAt])
  @@map("users")
}

model Wallet {
  id        Int @id @default(autoincrement())
  merchantId Int @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  environment MerchantGatewayEnv @map("environment")
  address   String
  chain     Chain
  /// Asset the client chose for this deposit rail (e.g. USDT, TRX).
  currency  String
  /// Client-facing network label (e.g. TRC20, ERC20, BEP20, TON, TRON).
  network   String
  derivationIndex Int @map("derivation_index")
  /// Current checkout assignee; null = in merchant pool (free or awaiting pickup).
  assignedUserId Int? @map("assigned_user_id")
  assignedUser   User?   @relation("WalletPoolAssignment", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// When set and in the future, the address is reserved for `assignedUserId` until success or this time passes.
  holdExpiresAt DateTime? @map("hold_expires_at")
  /// Live worker scans this row until this time (unless it has any transaction). Null = no active TTL window from assign.
  scanExpiresAt DateTime? @map("scan_expires_at")
  /// Merchant/admin “restart deposit scan”: include on the next worker tick once, then cleared.
  depositScanSingleTickRequested Boolean @default(false) @map("deposit_scan_single_tick_requested")
  createdAt DateTime @default(now()) @map("created_at")
  /// Last on-chain balance snapshot from admin “Refresh balances” (display string, e.g. `12.5 USDT`).
  cachedBalanceDisplay  String?   @map("cached_balance_display") @db.VarChar(256)
  cachedBalanceAtomic   String?   @map("cached_balance_atomic") @db.VarChar(128)
  cachedBalanceError    String?   @map("cached_balance_error") @db.VarChar(512)
  cachedBalanceUpdatedAt DateTime? @map("cached_balance_updated_at")
  deletedAt DateTime? @map("deleted_at")

  transactions Transaction[]
  assignmentEvents WalletAssignmentEvent[]

  @@index([merchantId, environment, chain, currency, network, address])
  @@index([merchantId, environment, chain, currency, network])
  @@index([assignedUserId])
  @@index([holdExpiresAt])
  @@index([chain, address])
  @@index([address])
  @@index([scanExpiresAt])
  @@index([depositScanSingleTickRequested])
  @@index([deletedAt])
  @@map("wallets")
}

/// Logged on each gateway wallet resolution (deposit-address). Not retroactive for data before migration.
model WalletAssignmentEvent {
  id          Int   @id @default(autoincrement())
  walletId    Int   @map("wallet_id")
  userId      Int   @map("user_id")
  merchantId  Int   @map("merchant_id")
  environment MerchantGatewayEnv @map("environment")
  /// existing_session | pool_pick | new_wallet
  source      String   @map("source") @db.VarChar(24)
  /// Random hex key for this checkout; copied to `Transaction.depositSessionKey` when a deposit row is created.
  depositSessionKey String? @map("deposit_session_key") @db.VarChar(64)
  /// Merchant checkout / order id from gateway body; copied to `Transaction.transaction_id` on new deposit rows.
  referenceTransactionId String? @map("reference_transaction_id") @db.VarChar(256)
  /// Smallest-unit integer string (e.g. USDT 6dp) when `deposit-address` sent optional `amount`; used for checkout + underpaid checks.
  expectedAmountAtomic String? @map("expected_amount_atomic") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  wallet   Wallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([merchantId, environment])
  @@index([deletedAt])
  @@map("wallet_assignment_events")
}

model Transaction {
  id                  Int       @id @default(autoincrement())
  walletId            Int       @map("wallet_id")
  /// End-user (merchant’s external user) this deposit belongs to — kept when the wallet returns to the pool.
  payerUserId         Int?      @map("payer_user_id")
  payerUser           User?     @relation(fields: [payerUserId], references: [id], onDelete: SetNull)
  txHash              String    @map("tx_hash")
  fromAddress         String    @map("from_address")
  toAddress           String    @map("to_address")
  amount              String
  tokenSymbol         String    @map("token_symbol")
  chain               Chain
  status              TxStatus  @default(pending)
  confirmations       Int       @default(0)
  blockNumber         BigInt?   @map("block_number")
  logIndex            Int       @default(-1) @map("log_index")
  tokenDecimals       Int       @default(18) @map("token_decimals")
  callbackDeliveredAt DateTime? @map("callback_delivered_at")
  /// Auto delivery tries (payment webhook POST, X-Webhook-Event: payment); capped by worker + upsert path; manual redeliver does not increment.
  callbackAttemptCount Int      @default(0) @map("callback_attempt_count")
  callbackLastAttemptAt DateTime? @map("callback_last_attempt_at")
  /// Matches `WalletAssignmentEvent.depositSessionKey` for the checkout session (`deposit-address` assignment).
  depositSessionKey   String?   @map("deposit_session_key") @db.VarChar(64)
  /// Merchant-provided id (gateway `transaction_id`); list/filter in portals.
  referenceTransactionId String? @map("transaction_id") @db.VarChar(256)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  /// When set, this deposit was included in a batch settlement payout.
  merchantSettlementId Int?  @map("merchant_settlement_id")
  merchantSettlement   MerchantSettlement? @relation(fields: [merchantSettlementId], references: [id], onDelete: SetNull)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  /// One row per on-chain event: same `tx_hash` cannot repeat for the same `chain` + `log_index` (TRON uses -1).
  @@unique([chain, txHash, logIndex], name: "tx_chain_log_unique")
  @@index([toAddress, chain])
  @@index([status])
  @@index([payerUserId])
  @@index([merchantSettlementId])
  /// List txs per wallet (portal, gateway) ordered by time.
  @@index([walletId, createdAt(sort: Desc)])
  @@index([walletId, depositSessionKey])
  @@index([referenceTransactionId])
  @@index([deletedAt])
  @@map("transactions")
}

model Withdrawal {
  id            Int              @id @default(autoincrement())
  merchantId    Int              @map("merchant_id")
  merchant      Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  chain         Chain
  tokenSymbol   String           @map("token_symbol")
  toAddress     String           @map("to_address")
  amount        String
  status        WithdrawalStatus @default(pending)
  txHash        String?          @map("tx_hash")
  failureReason String?          @map("failure_reason") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  @@index([merchantId, createdAt])
  @@index([deletedAt])
  @@map("withdrawals")
}

/// Immutable trail for support: gateway calls, callbacks, who/when (no secrets stored).
model AuditLog {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now()) @map("created_at")
  source         String
  action         String
  merchantId     Int?     @map("merchant_id")
  merchant       Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  actorEmail     String?  @map("actor_email")
  summary        String   @db.Text
  requestMethod  String?  @map("request_method")
  requestPath    String?  @map("request_path") @db.Text
  ipAddress      String?  @map("ip_address")
  metadata       Json     @default("{}")
  deletedAt      DateTime? @map("deleted_at")

  @@index([createdAt])
  @@index([merchantId])
  @@index([source, action])
  @@index([deletedAt])
  @@map("audit_logs")
}

/// Admin / merchant portal mutations (successful writes). Separate from gateway API + webhook audit_logs.
model PanelAuditLog {
  id                 Int      @id @default(autoincrement())
  createdAt          DateTime @default(now()) @map("created_at")
  /// Which UI surface: `admin` or `merchant` (profile/password use the user role the same way).
  panel              String
  actorId            String   @map("actor_id")
  actorRole          String   @map("actor_role")
  /// Merchant row affected when an admin edits a merchant; merchant panel = same as actor for own actions.
  targetMerchantId   String?  @map("target_merchant_id")
  method             String
  path               String   @db.Text
  httpStatus         Int      @map("http_status")
  summary            String   @db.Text
  metadata           Json     @default("{}")
  ipAddress          String?  @map("ip_address")
  deletedAt          DateTime? @map("deleted_at")

  @@index([createdAt])
  @@index([panel])
  @@index([actorId])
  @@index([targetMerchantId])
  @@index([deletedAt])
  @@map("panel_audit_logs")
}

model ScannerState {
  id        Int      @id @default(autoincrement())
  currency  String
  network   String
  /// Underlying chain RPC this cursor advances with (EVM: one cursor set per chain).
  chain     Chain
  lastBlock BigInt   @default(0) @map("last_block")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([currency, network])
  @@index([chain])
  @@index([deletedAt])
  @@map("scanner_state")
}

/// Key/value overrides for operational config; values win over process env when present.
model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([key])
  @@index([deletedAt])
  @@map("app_settings")
}
