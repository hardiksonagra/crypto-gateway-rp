generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Chain {
  ETH
  BNB
  POLYGON
  ARBITRUM
  OPTIMISM
  TRON
  BTC
  TON
}

enum TxStatus {
  pending
  success
  failed
}

enum AdminRole {
  ADMIN
  MERCHANT
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
}

/// Portal login: ADMIN (full ops) or MERCHANT (own data + API key for gateway).
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole
  displayName  String?   @map("display_name")
  /// SHA-256 hex of full secret; MERCHANT only.
  apiKeyHash   String?   @unique @map("api_key_hash")
  apiKeyHint   String?   @map("api_key_hint")
  /// AES-256-GCM ciphertext (base64) of gateway API secret — shown to merchant in portal Doc.
  apiKeyCipher String?   @map("api_key_cipher")
  callbackUrl   String?   @map("callback_url")
  /// Supported default chains for gateway (must include each rail’s underlying chain).
  defaultChains Chain[] @default([]) @map("default_chains")
  /// Default `currency` when deposit-address omits currency/network (portal + API).
  defaultCurrency String @default("USDT") @map("default_currency")
  /// Default `network` when deposit-address omits currency/network.
  defaultNetwork  String @default("TRC20") @map("default_network")
  /// Non-empty = gateway only allows these `CURRENCY|NETWORK` rails (must match default_chains).
  supportedDepositRails String[] @default([]) @map("supported_deposit_rails")
  isActive      Boolean @default(true) @map("is_active")
  /// SHA-256 hex of one-time password-reset token (plain token only in email).
  passwordResetTokenHash   String?   @map("password_reset_token_hash")
  passwordResetExpiresAt    DateTime? @map("password_reset_expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  endUsers    User[]
  withdrawals Withdrawal[]

  @@map("admin_users")
}

model User {
  id             String    @id @default(cuid())
  merchantId     String    @map("merchant_id")
  merchant       AdminUser @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  externalUserId String    @map("external_user_id")
  accountIndex   Int       @unique @default(autoincrement()) @map("account_index")
  createdAt      DateTime  @default(now()) @map("created_at")

  wallets Wallet[]

  @@unique([merchantId, externalUserId])
  @@map("users")
}

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  address         String
  chain           Chain
  /// Asset the client chose for this deposit rail (e.g. USDT, TRX).
  currency        String
  /// Client-facing network label (e.g. TRC20, ERC20, BEP20, TON, TRON).
  network         String
  derivationIndex Int      @map("derivation_index")
  createdAt       DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, chain, currency, network])
  @@index([chain, address])
  @@index([address])
  @@map("wallets")
}

model Transaction {
  id                  String    @id @default(cuid())
  walletId            String    @map("wallet_id")
  txHash              String    @map("tx_hash")
  fromAddress         String    @map("from_address")
  toAddress           String    @map("to_address")
  amount              String
  tokenSymbol         String    @map("token_symbol")
  chain               Chain
  status              TxStatus  @default(pending)
  confirmations       Int       @default(0)
  blockNumber         BigInt?   @map("block_number")
  logIndex            Int       @default(-1) @map("log_index")
  tokenDecimals       Int       @default(18) @map("token_decimals")
  callbackDeliveredAt DateTime? @map("callback_delivered_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([txHash, chain, walletId, tokenSymbol, logIndex], name: "tx_dedupe")
  @@index([toAddress, chain])
  @@index([status])
  @@map("transactions")
}

model Withdrawal {
  id            String           @id @default(cuid())
  merchantId    String           @map("merchant_id")
  merchant      AdminUser        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  chain         Chain
  tokenSymbol   String           @map("token_symbol")
  toAddress     String           @map("to_address")
  amount        String
  status        WithdrawalStatus @default(pending)
  txHash        String?          @map("tx_hash")
  failureReason String?          @map("failure_reason") @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([merchantId, createdAt])
  @@map("withdrawals")
}

model ScannerState {
  id        String   @id @default(cuid())
  currency  String
  network   String
  /// Underlying chain RPC this cursor advances with (EVM: one cursor set per chain).
  chain     Chain
  lastBlock BigInt   @default(0) @map("last_block")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([currency, network])
  @@index([chain])
  @@map("scanner_state")
}
