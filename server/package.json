{
  "name": "crypto-payment-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade multi-chain HD wallet payment system",
  "main": "src/index.js",
  "scripts": {
    "build": "node --check src/index.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../.env -e .env -- prisma migrate dev",
    "prisma:reset": "dotenv -e ../.env -e .env -- prisma migrate reset --force",
    "prisma:deploy": "dotenv -e ../.env -e .env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e ../.env -e .env -- prisma studio",
    "db:seed": "dotenv -e ../.env -e .env -- node prisma/seed.js",
    "sync-settings-from-env": "dotenv -e ../.env -e .env -- node scripts/sync-app-settings-from-env.js"
  },
  "prisma": {
    "seed": "dotenv -e ../.env -e .env -- node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.2",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "bip32": "^5.0.0-rc.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ecpair": "^3.0.0",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "tiny-secp256k1": "^2.2.3",
    "tronweb": "^6.0.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.5.0"
  }
}
