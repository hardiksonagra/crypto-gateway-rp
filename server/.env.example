# Database URL for Prisma: either copy this file to `server/.env`, or keep vars only in the
# monorepo root `.env` and link:  ln -sf ../.env .env   (from `server/`)
# so plain `npx prisma migrate deploy` sees DATABASE_URL. Or always use:  npm run prisma:deploy

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

JWT_SECRET="change-me-to-a-long-random-secret"
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_wallet?schema=public"
MNEMONIC="test test test test test test test test test test test junk"

# See root `.env.example` for RPC, tokens, and worker settings.
