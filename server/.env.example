# Copy to `server/.env` or keep a single `.env` at the monorepo root (server loads both).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

JWT_SECRET="change-me-to-a-long-random-secret"
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_wallet?schema=public"
MNEMONIC="test test test test test test test test test test test junk"

# See root `.env.example` for RPC, tokens, and worker settings.
